{
  "name": "oilpriceapi-mcp",
  "version": "3.2.4",
  "mcpName": "io.github.OilpriceAPI/mcp-server",
  "description": "Source-timestamped oil, gas, and related energy data plus reviewed product facts for MCP clients.",
  "type": "module",
  "bin": {
    "oilpriceapi-mcp": "./build/index.js"
  },
  "main": "./build/index.js",
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc && node scripts/copy-product-facts.mjs && node scripts/generate-build-metadata.mjs && node scripts/generate-capabilities.mjs && chmod 755 build/index.js",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:live": "node scripts/live-smoke.mjs",
    "generate:live-contracts": "node scripts/generate-live-contract-matrix.mjs",
    "smoke:live-contract-matrix": "node scripts/live-contract-matrix-smoke.mjs",
    "smoke:product-facts:live": "node scripts/live-product-facts-smoke.mjs",
    "smoke:registry-verifier": "node scripts/verify-mcp-registry-release-smoke.mjs",
    "smoke:npm-verifier": "node scripts/verify-npm-release-smoke.mjs",
    "smoke:release-provenance": "node scripts/verify-release-provenance-smoke.mjs",
    "smoke:public-claims": "node scripts/public-claims-smoke.mjs",
    "smoke:product-facts": "node scripts/product-facts-smoke.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "smoke:docker": "node scripts/docker-smoke.mjs",
    "test:product-facts": "npm run build && npm run smoke:product-facts",
    "verify:release-metadata": "node scripts/verify-release-metadata.mjs",
    "verify:release-provenance": "node scripts/verify-release-provenance.mjs",
    "verify:mcp-registry-release": "node scripts/verify-mcp-registry-release.mjs",
    "prepublishOnly": "npm audit --audit-level=low && npm run verify:release-metadata && npm run build && npm run smoke:public-claims"
  },
  "files": [
    "build/*.d.ts",
    "build/*.d.ts.map",
    "build/*.js",
    "build/*.js.map",
    "build/*.json",
    "build/*.sha256"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oil-prices",
    "commodity-prices",
    "energy",
    "brent-crude",
    "wti",
    "natural-gas",
    "claude",
    "anthropic"
  ],
  "author": "OilPriceAPI <support@oilpriceapi.com>",
  "license": "MIT",
  "homepage": "https://oilpriceapi.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/OilpriceAPI/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/OilpriceAPI/mcp-server/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  }
}
